{
  "__inputs": [
    {
      "name": "DS_COMICS_SCOUT",
      "label": "Comics scout (Supabase PostgreSQL)",
      "description": "The PostgreSQL data source that points to your Supabase project",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "title": "Comics scout",
  "uid": "comics-scout",
  "tags": [
    "comics-scout"
  ],
  "timezone": "Europe/Prague",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "cat",
        "label": "Category",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_COMICS_SCOUT}"
        },
        "query": "SELECT DISTINCT cat FROM public.scout_listings ORDER BY 1",
        "definition": "SELECT DISTINCT cat FROM public.scout_listings ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Active listings",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM scout.listing_history WHERE status='active' AND cat IN (${cat:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "id": 1,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Gone (likely sold)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM scout.listing_history WHERE status='gone' AND cat IN (${cat:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8F8F8F"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Bargains now (at/below your limit)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM scout.bargains WHERE cat IN (${cat:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "id": 3,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Last scout run",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT max(run_ts) AS value FROM public.scout_runs"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "dateTimeAsLocal"
        },
        "overrides": []
      },
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Cheapest price per book",
      "description": "Lowest offer for each book in every scout run (Kč). Bundle ads and ads without a price are not shown.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT run_ts AS \"time\", book AS metric, min_price AS value\nFROM scout.book_prices\nWHERE $__timeFilter(run_ts) AND min_price IS NOT NULL AND cat IN (${cat:sqlstring})\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyCZK",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Offers per category per run",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT run_ts AS \"time\", cat AS metric, sum(offers) AS value\nFROM scout.book_prices\nWHERE $__timeFilter(run_ts) AND cat IN (${cat:sqlstring})\nGROUP BY 1,2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Bargains now",
      "description": "Books whose cheapest offer in the latest run is at or below its limit (edit limits in Supabase → table scout_alert_limits).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT book AS \"Book\", min_price AS \"Cheapest\", max_price AS \"Your limit\", offers AS \"Offers\"\nFROM scout.bargains WHERE cat IN (${cat:sqlstring}) ORDER BY book"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Cheapest|Your limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyCZK"
              }
            ]
          }
        ]
      },
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Latest run – all listings",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT book AS \"Book\", title AS \"Title\", price AS \"Price\", price_text AS \"Price as shown\", site AS \"Site\", place AS \"Place / note\", cat AS \"Category\", url\nFROM scout.latest_listings WHERE cat IN (${cat:sqlstring})\nORDER BY book, price NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Title"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open listing",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Price"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyCZK"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Book",
            "desc": false
          }
        ]
      },
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "History – every listing ever found",
      "description": "active = in the latest run; gone = missing although its site was checked fully (likely sold); not checked = its site failed since.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_COMICS_SCOUT}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT status AS \"Status\", book AS \"Book\", title AS \"Title\", site AS \"Site\", first_seen AS \"First seen\", last_seen AS \"Last seen\", gone_since AS \"Gone since\", first_price AS \"First price\", price_now AS \"Price now\", price_change AS \"Change\", url\nFROM scout.listing_history WHERE cat IN (${cat:sqlstring})\nORDER BY last_seen DESC, book"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Title"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open listing",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "First price|Price now|Change"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyCZK"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "First seen|Last seen|Gone since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "active": {
                        "color": "green",
                        "index": 0
                      },
                      "gone": {
                        "color": "#8F8F8F",
                        "index": 1
                      },
                      "not checked": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 9,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_COMICS_SCOUT}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 12
      }
    }
  ]
}